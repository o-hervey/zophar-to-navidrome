# Copy to .env (docker compose) or paste into the Portainer stack's environment variables.
# Host folder for the music library. Must already exist.
MUSIC_DIR=/srv/music
# Host folder for Navidrome's database and the fetcher's job list/temp space. Created for you.
APPDATA=/opt/stacks/music
# Owner of the folders above: output of `id -u` and `id -g` for the user you want to own the files.
PUID=1000
PGID=1000
# Navidrome admin used only to trigger rescans. Placeholder until you create the real admin (step 5).
ND_USER=admin
ND_PASS=changeme
# Where each web UI listens. 127.0.0.1 = this server only. Use the Tailscale IP (`tailscale ip -4`) to reach it from your devices.
FETCH_BIND=127.0.0.1
NAVIDROME_BIND=127.0.0.1
# Host port for the fetcher page. 8085 because qBittorrent (via Gluetun) already uses 8080 on VM04.
FETCH_PORT=8085
# Optional: pin a Navidrome version.
# NAVIDROME_TAG=latest
